# Controlled sleep experiment: retain the exact v37 userspace/package inventory.
FROM scratch AS ctx
COPY surface/build /build
COPY surface/sleep /sleep

FROM ghcr.io/xelef2000/azurefin@sha256:bde3423be9353538f51aac7c2ae1fab7d882d44f44447a18ed791c8ce9f2fb04 AS base-image
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/sleep/10-kernel-only.sh && \
    bash /ctx/build/21-installer-firmware-free.sh installed && \
    bash /ctx/build/27-installed-boot.sh && \
    bash /ctx/build/29-clean-build-state.sh && \
    bootc container lint
