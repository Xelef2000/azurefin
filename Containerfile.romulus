# Default output: firmware-free bootstrap system; provision after installation.
# Microsoft firmware is only added by the explicit local-image target.
ARG BASE_IMAGE=quay.io/fedora/fedora-silverblue:44
FROM scratch AS ctx
COPY surface/build /build

FROM ${BASE_IMAGE} AS packages
COPY --from=ghcr.io/ublue-os/brew:latest@sha256:2aaf87e3757466bc28d056505a651c7ca5c56fd28f6ff709b34f3f5dbc860e89 /system_files /
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/10-packages.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/15-homebrew.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/19-check-firmware-free.sh

# Release CI publishes only the firmware-free base-image stage below.
# Select --target local-image explicitly for the firmware-complete image.
FROM packages AS local-image
ARG FIRMWARE_SOURCE=msi
COPY surface/installer_fix_fstab.py /usr/libexec/azurefin-installer-fix-fstab.py
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=secret,id=surface-msi \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/build/20-firmware-initramfs.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/27-installed-boot.sh
RUN bootc container lint

# Keep the default target independent of all firmware-inclusive layers.
FROM packages AS base-image
COPY surface/installer_fix_fstab.py /usr/libexec/azurefin-installer-fix-fstab.py
COPY surface/build/19-check-firmware-free.sh /usr/libexec/azurefin-check-firmware-free
COPY surface/postinstall_firmware.py /usr/bin/azurefin-setup-firmware
RUN chmod 0755 /usr/bin/azurefin-setup-firmware
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/21-installer-firmware-free.sh installed \
    && bash /ctx/build/27-installed-boot.sh
# Firmware provisioning creates a private local image. Do not automatically
# replace it with the public bootstrap image on subsequent boots.
RUN systemctl mask bootc-fetch-apply-updates.timer bootc-fetch-apply-updates.service
RUN bootc container lint
LABEL org.azurefin.firmware="post-install-provisioning"
