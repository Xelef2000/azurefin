# Default output: firmware-free bootstrap system; provision after installation.
# Microsoft firmware is only added by the explicit local-image target.
ARG BASE_IMAGE=quay.io/fedora/fedora-silverblue:44
FROM scratch AS ctx
COPY surface/build /build

FROM ${BASE_IMAGE} AS packages
COPY --from=ghcr.io/ublue-os/brew:latest@sha256:2aaf87e3757466bc28d056505a651c7ca5c56fd28f6ff709b34f3f5dbc860e89 /system_files /
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/10-packages.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/15-homebrew.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/16-ota-tools.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/17-uupd.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/18-bazaar.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/19-check-firmware-free.sh

# Release CI publishes only the firmware-free base-image stage below.
# Select --target local-image explicitly for the firmware-complete image.
FROM packages AS local-image
ARG FIRMWARE_SOURCE=msi
COPY surface/installer_fix_fstab.py /usr/libexec/azurefin-installer-fix-fstab.py
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=secret,id=surface-msi \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/build/20-firmware-initramfs.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/27-installed-boot.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/29-clean-build-state.sh && bootc container lint

# Keep the default target independent of all firmware-inclusive layers.
FROM packages AS base-image
COPY surface/ota-signing.pub /usr/lib/pki/containers/azurefin-ota.pub
COPY surface/native-ota/policy.json /etc/containers/policy.json
COPY surface/native-ota/azurefin.yaml /etc/containers/registries.d/azurefin.yaml
COPY surface/installer_fix_fstab.py /usr/libexec/azurefin-installer-fix-fstab.py
COPY surface/build/19-check-firmware-free.sh /usr/libexec/azurefin-check-firmware-free
COPY surface/postinstall_firmware.py /usr/libexec/azurefin/postinstall_firmware.py
COPY surface/update.py /usr/libexec/azurefin/update.py
COPY surface/firmware_bundle.py surface/firmware_store_probe.py /usr/libexec/azurefin/
COPY surface/firmware_preflight.py surface/setup_firmware_store.py /usr/libexec/azurefin/
RUN chmod 0755 /usr/libexec/azurefin/setup_firmware_store.py \
    && ln -s /usr/libexec/azurefin/setup_firmware_store.py /usr/bin/azurefin-setup-firmware \
    && ln -s /usr/libexec/azurefin/setup_firmware_store.py /usr/bin/azurefin-setup-firmware-store
COPY surface/dracut/91azurefin-firmware /usr/lib/dracut/modules.d/91azurefin-firmware
COPY surface/build /usr/share/azurefin/update-support/build
COPY surface/28-prepare-installer-payload.sh surface/Containerfile.provision surface/installer_fix_fstab.py /usr/share/azurefin/update-support/
RUN mkdir -p /usr/share/azurefin/update-support/firmware-tools \
    && cp /usr/bin/azurefin-extract-firmware /usr/share/azurefin/update-support/firmware-tools/ \
    && cp /usr/libexec/azurefin/firmware-policy.py /usr/share/azurefin/firmware-policy.json /usr/share/azurefin/update-support/firmware-tools/ \
    && chmod 0755 /usr/libexec/azurefin/update.py \
    && ln -s /usr/libexec/azurefin/update.py /usr/bin/azurefin-update
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/20-firmware-store.sh
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/21-installer-firmware-free.sh installed \
    && bash /ctx/build/27-installed-boot.sh
# Keep automatic OS updates off until signed staging, target firmware-policy
# compatibility and rollback are validated with the persistent firmware store.
RUN systemctl mask bootc-fetch-apply-updates.timer bootc-fetch-apply-updates.service
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    bash /ctx/build/29-clean-build-state.sh && bootc container lint
LABEL org.azurefin.firmware="post-install-provisioning"
