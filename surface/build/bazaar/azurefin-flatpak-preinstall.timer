[Unit]
Description=Retry application-store preparation after connecting to the network
ConditionKernelCommandLine=!rd.live.image
ConditionKernelCommandLine=!azurefin.live=1

[Timer]
OnBootSec=2min
OnUnitInactiveSec=15min
RandomizedDelaySec=1min
Unit=azurefin-flatpak-preinstall.service

[Install]
WantedBy=timers.target
